# FiBand — copy this file to `.env` and fill in the values.
#   cp .env.example .env

# BLE address of the band.
# On macOS this is a CoreBluetooth UUID (specific to your Mac), not a hardware MAC.
# Find it with a BLE scanner or in the logs on first connection.
BAND_ADDRESS=

# QWatch username (part before the '@') — required for the "rich" bc channel,
# i.e. historical SpO2 and sleep stages. Optional if you only use HR/steps/stress/HRV.
BAND_ACCOUNT=

# SQLite database file (relative to the project root)
DB_PATH=fiband.db

# OpenRouter — AI analysis of health data (key: https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Model to use for the analysis
OPENROUTER_MODEL=deepseek/deepseek-v4-pro

# Local timezone used to display/group the data and to anchor the band's
# on-device history (which is indexed in local time).
FIBAND_TZ=Asia/Jakarta
